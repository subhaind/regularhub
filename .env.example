# Google Apps Script web-app URL that receives every form submission.
# See google-apps-script/README.md. Leave empty to fall back to mailto links.
NEXT_PUBLIC_GAS_URL=

# --- Admin dashboard (see ADMIN.md) ---
ADMIN_EMAIL=
# generate both with: node scripts/hash-password.mjs "<12+ char password>"
ADMIN_PASSWORD_HASH=
SESSION_SECRET=
# Postgres connection string (required in production; local dev falls back to .data/store.json)
DATABASE_URL=
